{
  "Try / capture / finally": {
    "prefix": "try",
    "body": [
      "try to :",
      "    ${1:print(\"hello\")}",
      "capture error :",
      "    print(error[\"message\"])",
      "finally :",
      "    ${2:print(\"done\")}"
    ],
    "description": "try to / capture error / finally block with error inspection"
  },
  "Custom error definition": {
    "prefix": "error",
    "body": [
      "def error ${1:Name} :",
      "    code = ${2:1}",
      "    message = \"${3:message}\""
    ],
    "description": "def error Name with code and message fields"
  },
  "Raise a custom error": {
    "prefix": "raise",
    "body": "raise ${1:Name}(${2:code = 1})",
    "description": "raise ErrorName with field overrides"
  },
  "Function definition": {
    "prefix": "func",
    "body": [
      "def func ${1:name}(${2:param} (${3:str})) (${4:str}):",
      "    return ${5:\"\"}"
    ],
    "description": "def func with a parameter and return type"
  },
  "If / else": {
    "prefix": "if",
    "body": [
      "if ${1:condition} then :",
      "    ${2:print(\"yes\")}",
      "else :",
      "    ${3:print(\"no\")}"
    ],
    "description": "if condition then / else block"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:3} times repeat :",
      "    ${2:print(\"hi\")}"
    ],
    "description": "for N times repeat loop"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} repeat :",
      "    ${2:print(\"hi\")}"
    ],
    "description": "while condition repeat loop"
  },
  "Ask for input": {
    "prefix": "ask",
    "body": "def const ${1:name} (str) = ask \"${2:What is your name?}\"",
    "description": "ask prompt bound to a typed constant"
  },
  "Import a module": {
    "prefix": "import",
    "body": "import ${1:Module}",
    "description": "import a .lucc module or standard-library module"
  },
  "Print": {
    "prefix": "print",
    "body": "print(${1:\"hello\"})",
    "description": "print exactly one value"
  }
}
