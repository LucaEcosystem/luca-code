def const name (str) = "Luca"
if name is == to "Luca" then :
    print("Hello, {name}!")
else :
    print("Hello.")

def var score = 85
if score is >= to 90 then :
    print("A")
else if score is >= to 80 then :
    print("B")
else if score is >= to 70 then :
    print("C")
else :
    print("F")

def var x = 10
