def dict person = {"Name" = "Luca" (str), "Age" = 16 (int)}
print(person)
print(person["Name"])
print(person.contains(key = "Age"))
print(person.contains(value = 16))
person.add("City", "Berlin")
print(person)
change person["Age"] = 17
print(person)

